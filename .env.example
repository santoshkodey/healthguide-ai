# ==============================================================================
# HealthGuide AI — Environment Configuration Example
# ==============================================================================
# NOTE: The core rules-based safety navigation and OpenStreetMap hospital search
# run 100% out-of-the-box WITHOUT any paid API keys!
# The keys below are optional integrations to unlock Google Places and AI summaries.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hospital Discovery Provider (Optional)
# ------------------------------------------------------------------------------
# If set, HealthGuide AI will query Google Places API (New) for real-time facility search.
# If omitted, HealthGuide AI automatically uses OpenStreetMap Overpass API (Free/Open).
# GOOGLE_MAPS_API_KEY=your_google_places_api_key_here

# ------------------------------------------------------------------------------
# 2. AI Companion Insights (Optional)
# ------------------------------------------------------------------------------
# If set, provides cautious informational doctor-discussion questions via Gemini or OpenAI.
# If omitted, the application runs entirely on the transparent rules-based engine.
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 3. Application Port (Optional)
# ------------------------------------------------------------------------------
PORT=3000
